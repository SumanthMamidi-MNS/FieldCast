# Default: the real FastAPI backend, reached through the Vite dev proxy (/api -> localhost:8000).
# Set to "true" to run entirely on the in-browser mock instead.
VITE_USE_MOCK=false

# Optional: absolute backend URL for a deployed build. Leave unset in dev to use the proxy.
# VITE_API_BASE_URL=http://localhost:8000

# Region key served by the backend (backend/config.py).
VITE_REGION=mh_ghats
